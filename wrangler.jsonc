// hypoland.org: the files in web/ served as static assets by a Cloudflare Worker.
// Deployed by .github/workflows/cloudflare.yml.
{
  "name": "hypoland",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./web"
  },
  "routes": [
    { "pattern": "hypoland.org", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}

# Maintainer: Jonny Heggheim <hegjon@gmail.com>
#
# Builds Hypoland from the working tree this PKGBUILD lives in:
#   cd packaging/arch && makepkg -f
#
# The package replaces hyprland: it provides the same config path, IPC sockets,
# session files and the start-hyprland command name. There is no Hyprland / hyprland command.

pkgname=hypoland
pkgver=0.1.0.r606.gc1517a245
pkgrel=1
pkgdesc='A fork of the Hyprland Wayland compositor for OpenGL ES 2.0 hardware'
arch=(x86_64)
url='https://github.com/hegjon/hypoland'
license=(BSD-3-Clause)
depends=(
  cairo
  glib2
  glibc
  hyprcursor
  hyprgraphics
  hyprlang
  hyprutils
  hyprwire
  lcms2
  libcanberra
  libdisplay-info
  libdrm
  libei
  libgcc
  libglvnd
  libinput
  libstdc++
  libx11
  libxcb
  libxcomposite
  libxcursor
  libxfixes
  libxkbcommon
  libxrender
  lua
  mesa
  muparser
  opengl-driver
  pango
  pixman
  re2
  readline
  sdbus-cpp
  seatd
  systemd-libs
  util-linux-libs
  wayland
  wayland-protocols
  xcb-proto
  xcb-util
  xcb-util-errors
  xcb-util-image
  xcb-util-keysyms
  xcb-util-renderutil
  xcb-util-wm
  xorg-xwayland
)
# hyprland-protocols is a git submodule
makedepends=(
  binutils
  cmake
  git
  hwdata
  hyprwayland-scanner
  xorgproto
)
optdepends=(
  'xdg-desktop-portal-hyprland: xdg-desktop-portal backend'
  'wf-recorder: screen recording, gpu-screen-recorder needs GLES 3 (Omarchy falls back to wf-recorder)'
)
_root="$(realpath "$startdir/../..")"

# the Hyprland version it is based on, VERSION is the version of Hypoland
provides=("hyprland=$(cat "$_root/VERSION_HYPRLAND")" wayland-compositor
  # a Hyprland plugin that Omarchy installs (it needs hyprland=0.56.2), Hypoland has no plugins.
  # Providing it lets Omarchy's install and migration find it, its Lua skips titlebars without the .so
  omarchy-hyprland-titlebars)
conflicts=(hyprland omarchy-hyprland-titlebars)
# the embedded aquamarine is linked statically and relies on weakened symbols
options=(!lto)

pkgver() {
  cd "$_root"
  # a release tag gives the plain version, every other commit sorts after the release before it
  if [ "$(git describe --tags --exact-match HEAD 2>/dev/null)" = "v$(cat VERSION)" ]; then
    cat VERSION
    return
  fi
  printf '%s.r%s.g%s' "$(cat VERSION)" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  # baseline x86-64: the target machines are much older than the build machine
  local flags='-march=x86-64 -mtune=core2'
  cmake -S "$_root" -B "$srcdir/build" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_C_FLAGS="$CFLAGS $flags" \
    -DCMAKE_CXX_FLAGS="$CXXFLAGS $flags" \
    -DCMAKE_SKIP_RPATH=ON
  cmake --build "$srcdir/build" --parallel "$(nproc)"
}

package() {
  DESTDIR="$pkgdir" cmake --install "$srcdir/build"

  install -Dm644 "$_root/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$_root/subprojects/aquamarine/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.aquamarine"
}
